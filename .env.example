# ==============================================================================
# LocalBiz Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or production secrets to Git!
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
# 'production' enables strict security headers, sanitized error responses,
# HSTS, structured JSON logging, and production CORS enforcement.
NODE_ENV=production

# The port on which the Express server listens (default: 3000)
PORT=3000

# 2. DATABASE CONFIGURATION
# SQLite connection string (default for self-contained single-node deployments).
# For production PostgreSQL / MySQL, set provider in schema.prisma and specify the connection URI:
#   DATABASE_URL="postgresql://user:password@localhost:5432/localbiz_prod?schema=public"
DATABASE_URL="file:./dev.db"

# 3. AUTHENTICATION & SECURITY SECRETS
# Generate a cryptographically secure 64-character random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"

# JWT Token expiration window (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN="7d"

# 4. REVERSE PROXY & NETWORKING
# Enable trust proxy if LocalBiz is deployed behind Nginx, Cloudflare, AWS ALB, or Traefik.
# Set to 1 (number of hops) or 'true' to trust the first proxy hop for X-Forwarded-For IP detection.
TRUST_PROXY=1

# 5. CORS ALLOWED ORIGINS
# Comma-separated list of allowed frontend origins in production.
# In development, leave blank or set to '*' to allow localhost connections.
CORS_ORIGIN="https://localbiz.co.za,https://admin.localbiz.co.za"

# 6. RATE LIMITING (SLIDING WINDOW)
# Window size in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of authentication/sensitive requests allowed per IP per window
RATE_LIMIT_MAX=100

# 7. LOGGING & OBSERVABILITY
# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL="info"

# 8. ADMINISTRATIVE SEED CONFIGURATION
# Default Super Admin credentials for bootstrap initialization
ADMIN_EMAIL="admin@localbiz.co.za"
ADMIN_PASSWORD="replace-with-a-very-strong-admin-password"

# 9. PAYMENT GATEWAY CONFIGURATION
# Environment mode: 'sandbox' | 'production'
PAYMENT_GATEWAY_ENV="sandbox"

# Webhook signing secret for asynchronous payment gateway callbacks (IPN)
PAYMENT_WEBHOOK_SECRET="replace-with-gateway-webhook-signing-secret"
